{
  "name": "AnimeManager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node tools/cli.cjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx src tests --ext .ts,.tsx --max-warnings 0",
    "format:check": "prettier --check App.tsx src tests",
    "static": "npm run typecheck && npm run lint && npm run format:check && node tools/check-source.cjs",
    "test": "jest --runInBand",
    "cli": "node tools/cli.cjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "fflate": "0.8.2",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-video": "6.19.3",
    "react-native-windows": "0.85.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@rnx-kit/jest-preset": "0.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "AnimeManager",
      "namespace": "AnimeManager",
      "template": "cpp-app"
    }
  }
}
